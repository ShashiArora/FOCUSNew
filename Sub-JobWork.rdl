<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <Description>Trelleborg</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=TSSBLRFSH101;Initial Catalog=FSDBBR</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>cdd717d2-040c-463c-93b5-639830b8389a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@OrderNumber">
            <Value>=Parameters!OrderNumber.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select a.DC_NO,a.PONUMBER PONUMBER,a.VendorID,a.DC_DATETIME,c.LotNumber,d.ItemUM,c.ItemNumber,c.ComponentItemNumber,d.ItemDescription,isnull(g.[HSN Code],'--')'HSN Code', 
(isnull(sum(c.IssuedQuantity),0))-(isnull(sum(f.IssuedQuantity),0))'IssuedQuantity',
e.VendorName,e.VendorAddress1+', '+e.VendorAddress2+', '+e.VendorCity+', '+e.VendorState+', '+e.VendorCountry+'-'+e.VendorZip VendorAddress,a.Remarks1,a.Remarks2,h.IntrastatReference1 'GSTIN',
case  when a.DC_NO &lt; 0 
then '-' else '' end+LTRIM(RTRIM(DCMASK))+RIGHT('0000'+replace(a.DC_NO,'-',''), 5) as DcNumber
 from  FSPrograms..TSS_NoLock_SubDc_Details a

left outer join _NoLock_FS_POLine b on b.POLineKey=a.POLineKey
Left Outer Join TSS_NoLock_FS_HistoryPick_SubJobWork  c with (Nolock) on   a.PO_LineNum=c.LineNumber and c.OrderNumber = a.PONUMBER
left outer join _NoLock_FS_Item d on d.ItemNumber=c.ComponentItemNumber
left outer Join _NoLock_FS_Vendor e on e.VendorID=a.VendorID
left outer join (select Top 1000 * from TSS_NoLock_FS_HistoryPick_SubJobWork with (Nolock) where IssueType='X') f on  a.PO_LineNum=f.LineNumber and f.OrderNumber = a.PONUMBER  and f.LotNumber=c.LotNumber
left outer join TSS_Item_Master_HSNCode g with (Nolock) on g.ItemKey=d.ItemKey 
left outer join  FS_IntrastatVendorData h on h.VendorKey=e.VendorKey
inner join FSPrograms.. TSS_SubDc_Config i on i.YEAR=YEAR(a.DC_DATETIME)
where a.DC_NO=@OrderNumber    and Year(a.DC_DATETIME)=@Year  --  'TDS170055' 
and isnull(c.IssuedQuantity,0)+isnull(f.IssuedQuantity,0)&gt;0
and c.IssueType='I'
group by  a.DC_NO,a.PONUMBER,a.VendorID,a.DC_DATETIME,c.LotNumber,d.ItemUM,c.ItemNumber,c.ComponentItemNumber,d.ItemDescription,
e.VendorName,e.VendorAddress1,e.VendorAddress2,e.VendorCity,e.VendorState,e.VendorCountry,e.VendorZip,a.Remarks1,a.Remarks2,g.[HSN Code],h.IntrastatReference1,a.DC_NO,i.DCMASK
order by c.ComponentItemNumber asc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DC_NO">
          <DataField>DC_NO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PONUMBER">
          <DataField>PONUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VendorID">
          <DataField>VendorID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DC_DATETIME">
          <DataField>DC_DATETIME</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LotNumber">
          <DataField>LotNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemUM">
          <DataField>ItemUM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemNumber">
          <DataField>ItemNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComponentItemNumber">
          <DataField>ComponentItemNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemDescription">
          <DataField>ItemDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HSN_Code">
          <DataField>HSN Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IssuedQuantity">
          <DataField>IssuedQuantity</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="VendorName">
          <DataField>VendorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VendorAddress">
          <DataField>VendorAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remarks1">
          <DataField>Remarks1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remarks2">
          <DataField>Remarks2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GSTIN">
          <DataField>GSTIN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DcNumber">
          <DataField>DcNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select distinct Year(a.DC_DATETIME)	Year  from FSPrograms.. TSS_NoLock_SubDc_Details a
order by  Year(a.DC_DATETIME)  desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
